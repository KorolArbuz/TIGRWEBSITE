# Обязательно замените перед публикацией
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=change-me-now

STORE_NAME=ХОКО Каталог
STORE_PHONE=+7 999 000-00-00
STORE_TELEGRAM=

# Данные оператора для Политики обработки персональных данных.
# Перед публикацией укажите реальные реквизиты.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
# Меняйте версию при каждом существенном изменении текста политики.
PRIVACY_POLICY_VERSION=2026-09-02

# 1.0 = цена из Excel; 1.25 = наценка 25%
PRICE_MULTIPLIER=1.0

# Необязательно: уведомления о новых заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Включить после настройки HTTPS
SESSION_COOKIE_SECURE=false

# Для docker-compose.prod.yml
DOMAIN=shop.example.com
