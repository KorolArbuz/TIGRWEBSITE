# Safe template: generate local credentials with scripts/setup_security.py.
# Copying this file alone does not produce a runnable configuration.
APP_ENV=production
SECRET_KEY=
ADMIN_PASSWORD_HASH=
SESSION_COOKIE_SECURE=true
ALLOWED_HOSTS=localhost,127.0.0.1

STORE_NAME=ХОКО Каталог
STORE_PHONE=
STORE_TELEGRAM=

# Данные оператора для Политики обработки персональных данных.
# Перед публикацией укажите реальные реквизиты.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
# Меняйте версию при каждом существенном изменении текста политики.
PRIVACY_POLICY_VERSION=2026-09-02

# 1.0 = цена из Excel; 1.25 = наценка 25%
PRICE_MULTIPLIER=1.0

# Необязательно: уведомления о новых заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required real hostname for production Compose; no scheme or port.
DOMAIN=

# Administrative session: 30 minutes idle, 8 hours absolute.
ADMIN_IDLE_SECONDS=1800
ADMIN_ABSOLUTE_SECONDS=28800
# Requests per client IP in a finite window; account for shared NAT.
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW=300
CHECKOUT_RATE_LIMIT=60
CHECKOUT_RATE_WINDOW=600
