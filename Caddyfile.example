{
	# Runtime error logs can contain request URLs; disable them to avoid bearer-token leaks.
	log default {
		output discard
	}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	@private path /admin /admin/* /order/* /checkout
	header @private {
		Cache-Control no-store
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	# Errors generated by Caddy use a separate handler chain (including 413/502).
	handle_errors {
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			Cache-Control no-store
			X-Robots-Tag "noindex, nofollow, noarchive"
			-Server
		}
		respond "Request failed." {err.status_code}
	}
	# Keep these byte budgets aligned with shop.security.SecurityEnvelope.
	route {
		@login path /admin/login
		handle @login {
			request_body {
				max_size 16384
			}
			reverse_proxy shop:8000
		}
		@import path /admin/import
		handle @import {
			request_body {
				max_size 134217728
			}
			reverse_proxy shop:8000
		}
		handle {
			request_body {
				max_size 65536
			}
			reverse_proxy shop:8000
		}
	}
	# Access logging intentionally stays disabled, including /order/{token} URLs.
	# Enable HSTS only after verifying the site's HTTPS deployment:
	# header Strict-Transport-Security "max-age=31536000"
}
